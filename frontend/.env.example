# =============================================================================
# Vaibhav Celebrations — Frontend (Public Website) Environment Variables
# Document references: 02, 05, 10 (SEO/Analytics)
# Only NEXT_PUBLIC_* vars are exposed to the browser.
# =============================================================================

# Backend API base URL (server + client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server-side (SSR/API-route) override for the backend base URL — takes
# priority over NEXT_PUBLIC_API_BASE_URL for requests made from the Node
# server only (never sent to the browser). Useful when the server should
# reach the backend over an internal/private network address while the
# browser still uses the public one. Falls back to NEXT_PUBLIC_API_BASE_URL
# (then http://localhost:4000/api/v1) if unset — see frontend/src/lib/api-client.ts.
INTERNAL_API_URL=http://localhost:4000/api/v1

# Origin (no /api/v1 suffix) the Next.js dev/prod rewrite of "/api/v1/*"
# proxies to — see frontend/next.config.ts. Defaults to http://localhost:4000.
BACKEND_ORIGIN=http://localhost:4000

# Site URL (canonical / OG / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp enquiry CTA (click-to-chat — Document 05 §5.2)
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_PREFILL_MESSAGE=Hi Vaibhav Celebrations! I would like to know more about your birthday packages.

# Analytics (Document 10) — leave empty until client provides IDs
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Razorpay Checkout (public key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# On-demand ISR revalidation secret (must match backend REVALIDATE_SECRET)
REVALIDATE_SECRET=change_me_revalidate_secret_min_32_chars
