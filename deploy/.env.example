# Compose-level settings for docker-compose.prod.yml  ->  copy to ./.env  (never commit the real file)

# ── Hostnames (DNS A/AAAA records must point at this server / load balancer) ──
SITE_HOST=www.example.com
API_HOST=api.example.com
ADMIN_HOST=admin.example.com
# Name of the Let's Encrypt certificate lineage (folder in /etc/letsencrypt/live). Defaults to SITE_HOST.
# CERT_NAME=www.example.com

# nginx template set: ./deploy/nginx/templates-https (self-managed TLS)  |  ./deploy/nginx/templates-http (TLS at an upstream LB)
NGINX_TEMPLATES=./deploy/nginx/templates-https

# ── Secrets shared by services (generate:  openssl rand -hex 32) ──
REDIS_PASSWORD=
REVALIDATE_SECRET=

# ── Public (build-time) values baked into the website bundle ──
CDN_HOST=cdn.vaibhavcelebrations.in
WHATSAPP_NUMBER=
WHATSAPP_PREFILL_MESSAGE=Hi Vaibhav Celebrations! I would like to plan a celebration.
RAZORPAY_KEY_ID=
GA4_ID=
GTM_ID=
META_PIXEL_ID=

# ── Release control ──
IMAGE_TAG=latest
# Set true for ONE deploy (or on a single instance) to apply pending Prisma migrations, then unset.
RUN_MIGRATIONS=false

# ── Only when using the local-db profile (skip for Neon / RDS / Cloud SQL) ──
POSTGRES_USER=vbc
POSTGRES_DB=vaibhav_celebrations
POSTGRES_PASSWORD=
