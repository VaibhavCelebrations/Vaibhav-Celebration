# API runtime secrets  ->  copy to deploy/env/backend.env  (gitignored; never commit)
# Generate every secret with:  openssl rand -base64 48
# NODE_ENV, PORT, TRUST_PROXY, REDIS_URL, ENFORCE_PRODUCTION_CHECKS are set by docker-compose.prod.yml.

# ── Database (Neon / RDS / Cloud SQL, or postgres://USER:PASS@postgres:5432/DB for the local-db profile) ──
DATABASE_URL=

# ── Origins (exact https origins, comma-separated, no trailing slash, NO localhost) ──
CORS_ORIGINS=https://www.example.com,https://admin.example.com
FRONTEND_URL=https://www.example.com
API_PREFIX=/api/v1
COOKIE_SECURE=true
ALLOW_VERCEL_PREVIEWS=false

# ── JWT — three DIFFERENT random secrets, >= 32 chars ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_CUSTOMER_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_CUSTOMER_ACCESS_EXPIRES_IN=15m

# ── Razorpay (LIVE keys in production; RAZORPAY_MODE=live is cross-checked against the key prefix) ──
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Vaibhav Celebrations
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Media (Cloudflare R2) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://cdn.example.com
MEDIA_MAX_UPLOAD_MB=50

# ── Cache revalidation (must equal REVALIDATE_SECRET in the compose .env) ──
REVALIDATE_SECRET=
FRONTEND_REVALIDATE_URL=http://frontend:3000/api/revalidate

# ── Rate limits (defaults are sensible; tune from real traffic) ──
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_ADMIN=1000
RATE_LIMIT_MAX_UPLOAD=100
RATE_LIMIT_CHATBOT_SESSIONS_PER_HOUR=10
RATE_LIMIT_CHATBOT_FLOW_PER_MINUTE=60

# ── Misc ──
LOG_LEVEL=info
DEFAULT_GST_PERCENT=18
