# =============================================================================
# Vaibhav Celebrations — Admin Panel Environment Variables
# Document references: 02 §3.2, 08 (Admin Spec), 09 (Security)
# Admin must never be indexed or linked from the public site.
# =============================================================================

# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Admin app URL (for cookies / redirects)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Public website URL (for preview links in CMS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
