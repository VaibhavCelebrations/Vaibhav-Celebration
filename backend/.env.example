# =============================================================================
# Vaibhav Celebrations — Backend Environment Variables
# Document references: 02 (Architecture), 04 (API), 09 (Security), 12 (WhatsApp)
# Copy to .env and fill real values. NEVER commit .env.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PRODUCTION: Set to comma-separated list of EXACT production origins only.
# Do NOT include localhost or staging origins in production.
# Example: CORS_ORIGINS=https://admin.vaibhavcelebrations.in,https://vaibhavcelebrations.in
# --- CORS allowlist (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Local Docker: docker compose up -d  (see root docker-compose.yml)
DATABASE_URL=postgresql://vbc:vbc_dev_password@localhost:5433/vaibhav_celebrations?schema=public

# --- CORS allowlist (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Admin JWT Auth (Document 04 §2, Document 09 §3.2) ---
# Generate strong secrets: openssl rand -base64 48
# PRODUCTION: Rotate these immediately if they have ever appeared in logs, error
# reports, or were shared outside a secrets manager. Treat any exposed secret
# as fully compromised and invalidate all active sessions.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_xxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_xxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# PRODUCTION: Set to true. Without this, refresh cookies are sent over plain HTTP.
# In development, false is acceptable for localhost testing.
COOKIE_SECURE=false

# --- Customer (storefront) Auth — fully httpOnly-cookie based, never in JS ---
# Deliberately a DIFFERENT secret from the admin JWT secrets above so a leak of
# one surface never compromises the other.
JWT_CUSTOMER_ACCESS_SECRET=change_me_customer_access_secret_min_32_chars_xx
JWT_CUSTOMER_ACCESS_EXPIRES_IN=15m
# "Stay logged in until the cookie is removed": sliding expiry renewed on every
# refresh while the user is active, capped by an absolute re-auth ceiling.
CUSTOMER_SESSION_SLIDING_DAYS=60
CUSTOMER_SESSION_ABSOLUTE_DAYS=180
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
CUSTOMER_MAX_FAILED_LOGINS=5
CUSTOMER_LOCKOUT_MINUTES=15
# Base URL used to build absolute links in reset/verification emails
FRONTEND_URL=http://localhost:3000

# --- Guest OTP (Document 04 §2) ---
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
GUEST_TOKEN_EXPIRES_MINUTES=30

# --- Seed Super Admin (used by prisma/seed.ts only) ---
SEED_ADMIN_EMAIL=admin@vaibhavcelebrations.in
SEED_ADMIN_PASSWORD=ChangeMe_SuperAdmin_123!
SEED_ADMIN_NAME=Super Admin

# --- Razorpay (Document 02 §6.1) — client-owned account ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
RAZORPAY_MODE=test

# --- Email / SMTP — Titan Mail (Docs/read/04-SMTP-Titan-Support-Email-Setup.md) ---
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@vaibhavcelebrations.in
SMTP_PASS=your_titan_mailbox_password
EMAIL_FROM_NAME=Vaibhav Celebrations
EMAIL_FROM_ADDRESS=support@vaibhavcelebrations.in
EMAIL_REPLY_TO=support@vaibhavcelebrations.in

# --- WhatsApp — Meta Cloud API (Docs/read/02-Meta-WhatsApp-Cloud-API-Setup.md) ---
# WHATSAPP_PROVIDER=mock simulates sends locally (no network call, no real
# message) so the full order/invoice/phone-verification flow can be tested
# without Meta being configured. Switch to WHATSAPP_PROVIDER=meta and set
# WHATSAPP_ENABLED=true only once real credentials below are filled in.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock

# Business WhatsApp number — display/contact use only. NEVER used as the
# Graph API sending endpoint (that's WHATSAPP_META_PHONE_NUMBER_ID below).
WHATSAPP_BUSINESS_NUMBER=918769895174

# Meta Cloud API credentials — backend-only, never sent to the frontend.
# Leave blank until Meta has issued real values; do NOT invent placeholders.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# WhatsApp Business Account (WABA) ID — not a secret, but backend-only.
WHATSAPP_META_BUSINESS_ACCOUNT_ID=28796364563290084
WHATSAPP_META_API_VERSION=

# Webhook verification token you choose (must match Meta App dashboard) and
# the App Secret used to verify X-Hub-Signature-256. Leave blank until set.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Phone verification (WhatsApp link-based, mirrors email verification TTL)
PHONE_VERIFICATION_TOKEN_TTL_MINUTES=30
# Explicit opt-in required for scripts/test-whatsapp.ts to send a REAL message.
TEST_WHATSAPP_SEND=false

# --- Cloudflare Media / CDN (Document 02 §6.4) ---
# R2 S3-compatible credentials. Leave blank for local uploads/ fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=vaibhav-celebrations-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://cdn.vaibhavcelebrations.in
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# Optional: when R2 unset, local files served from /uploads
# PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# --- Frontend revalidation webhook (Document 04 §12) ---
REVALIDATE_SECRET=change_me_revalidate_secret_min_32_chars
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate

# --- Rate limiting (Document 09 §3.2) ---
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_PUBLIC=100
# Admin-panel routes: keyed per JWT sub (user ID) — NOT by IP
RATE_LIMIT_MAX_ADMIN=1000
# Per-admin media upload limit (presign + multipart) within the same window
RATE_LIMIT_MAX_UPLOAD=100

# --- Operational defaults (overridable via OperationalSetting table) ---
DEFAULT_GST_PERCENT=18
DEFAULT_MAX_BOOKINGS_PER_DAY=2
MIN_CONSULTATION_ADVANCE_DAYS=15
GIFT_REGISTRY_VALIDITY_DAYS=30

# --- Observability (Document 02 §11) ---
LOG_LEVEL=info
